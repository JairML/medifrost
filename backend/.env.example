# Copiar este archivo como .env y completar los valores (el .env NO se sube a GitHub)
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pegar-aqui-la-clave-service_role-o-secret-key
# Solo para el simulador del nodo (npm run simular): la clave PÚBLICA publishable/anon, la misma del ESP32
SUPABASE_ANON_KEY=pegar-aqui-la-clave-publishable-o-anon
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# true = usa datos en memoria (sin Supabase), útil para probar o como respaldo en la demo
USE_MEMORY_DB=false
# Modo demo: cada cuántos segundos se genera una lectura simulada
DEMO_INTERVALO_S=10
